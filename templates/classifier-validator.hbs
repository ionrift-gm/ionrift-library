<div class="ionrift-app-container" style="display:flex; flex-direction:column; height:100%;">

    <!-- Dashboard Header -->
    <div class="dashboard-header">
        <div class="dashboard-stat">
            <div class="dashboard-gauge" style="--pct: {{stats.integrity}}%">
                <span>{{stats.mean}}%</span>
            </div>
            <div class="dashboard-text">
                <span class="label">{{localize "ionrift-library.classifierValidator.manifestIntegrity"}}</span>
                <span class="value">{{stats.identified}} / {{stats.total}}</span>
                <span class="label" style="margin-top:2px;">
                    <span class="ionrift-status {{stats.integrityClass}}">{{stats.integrityLabel}}</span>
                </span>
            </div>
        </div>

        <div class="ionrift-search-container">
            <i class="fas fa-search"></i>
            <input type="text" id="validator-search" class="ionrift-search-input"
                placeholder="{{localize "ionrift-library.classifierValidator.searchPlaceholder"}}" value="{{filters.query}}">
        </div>

        <div style="display:flex; gap: 8px; align-items: center;">
            <select id="confidence-filter" class="manifest-glass-select" style="width: 140px;">
                <option value="all">{{localize "ionrift-library.classifierValidator.filterAllEntities"}}</option>
                <option value="low">{{localize "ionrift-library.classifierValidator.filterNeedsReview"}}</option>
                <option value="med">{{localize "ionrift-library.classifierValidator.filterUncertain"}}</option>
            </select>
            <button type="button" id="toggle-sources-drawer" class="sources-toggle-btn ionrift-btn-subtle {{#if sources.showDrawer}}active{{/if}}" title="{{localize "ionrift-library.classifierValidator.configureSourcesTooltip"}}">
                <i class="fas fa-layer-group"></i> <span class="btn-text">{{localize "ionrift-library.classifierValidator.sourcesButton" count=sources.activeCount}}</span>
            </button>
            <button type="button" id="refresh-validator" title="{{localize "ionrift-library.classifierValidator.rescanTooltip"}}"><i class="fas fa-sync {{#if isScanning}}fa-spin{{/if}}"></i></button>
        </div>
    </div>

    <!-- Compendium Sources Drawer -->
    {{#if sources.showDrawer}}
    <div class="entity-sources-drawer">
        <div class="drawer-header">
            <span><i class="fas fa-layer-group"></i> {{localize "ionrift-library.classifierValidator.indexedSources"}}</span>
            <span class="drawer-hint">{{localize "ionrift-library.classifierValidator.indexedSourcesHint"}}</span>
        </div>
        <div class="sources-list">
            <label class="source-item">
                <input type="checkbox" name="source_world" {{#if sources.includeWorld}}checked{{/if}}>
                <span class="source-name"><i class="fas fa-globe"></i> {{localize "ionrift-library.classifierValidator.worldActors"}}</span>
            </label>
            {{#each sources.packs}}
            <label class="source-item">
                <input type="checkbox" name="pack_{{this.id}}" data-pack-id="{{this.id}}" {{#if this.isSelected}}checked{{/if}}>
                <span class="source-name"><i class="fas fa-book"></i> {{this.label}}</span>
                <span class="source-package">{{this.packageName}}</span>
            </label>
            {{/each}}
        </div>
        <div class="drawer-footer">
            <button type="button" id="apply-sources-btn" class="ionrift-save-btn">
                <i class="fas fa-arrows-rotate"></i> {{localize "ionrift-library.classifierValidator.reindexSourcesButton"}}
            </button>
        </div>
    </div>
    {{/if}}

    <!-- Results List -->
    <div class="ionrift-list">
        {{#each results}}
        <div class="ionrift-list-item" data-conf="{{this.confidence}}">
            <img src="{{this.img}}" class="avatar" alt="{{this.name}}" onerror="this.src='icons/svg/mystery-man.svg'">

            <div class="content">
                <div class="title">
                    <a class="actor-link" data-id="{{this.actorId}}" data-uuid="{{this.uuid}}"
                        style="color: var(--ionrift-accent);">{{this.name}}</a>
                </div>
                <div class="subtitle">
                    <i class="fas fa-database"></i> {{this.source}}
                </div>
            </div>

            <div class="badges">
                <!-- Class Badge (click to override) -->
                <button type="button"
                    class="ionrift-badge classifier-override-btn {{#if this.isManual}}manual{{else}}{{#if (or (eq this.rawClassId 'unknown') (eq this.classId 'Unknown'))}}error{{else}}success{{/if}}{{/if}}"
                    title="{{#if this.isManual}}{{localize "ionrift-library.classifierValidator.manualClassificationTooltip"}}{{else}}{{localize "ionrift-library.classifierValidator.detectedClassTooltip"}}{{/if}}"
                    data-actor-id="{{this.actorId}}"
                    data-uuid="{{this.uuid}}"
                    data-class-id="{{this.rawClassId}}"
                    data-manual="{{this.isManual}}">
                    <i class="fas {{#if this.isManual}}fa-lock{{else}}fa-chess-piece{{/if}}"></i> {{this.classId}}
                </button>

                <!-- Sound Badge -->
                <span class="ionrift-badge {{#if (or (eq this.rawSoundKey 'MONSTER_GENERIC') (eq this.soundKey 'Generic Monster'))}}warning{{else}}success{{/if}}"
                    title="{{localize "ionrift-library.classifierValidator.assignedSoundTooltip"}}">
                    <i class="fas fa-music"></i> {{this.soundKey}}
                </span>

                <!-- Score Pill -->
                <span class="score-pill {{this.scoreClass}}" title="{{localize "ionrift-library.classifierValidator.confidenceTooltip" pct=this.confidencePct}}">
                    {{this.confidencePct}}%
                </span>
            </div>
        </div>
        {{else}}
        <div class="no-results" style="padding: 40px; text-align: center; color: #888;">
            <i class="fas fa-search" style="font-size: 3em; margin-bottom: 20px; opacity: 0.5;"></i>
            <p>{{localize "ionrift-library.classifierValidator.noResults"}}</p>
        </div>
        {{/each}}
    </div>

    <!-- Footer -->
    <div class="glass-footer"
        style="padding: 10px 20px; background: rgba(0,0,0,0.4); border-top: 1px solid rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: space-between; gap: 20px;">

        <!-- Left: Source Info (Fixed width to prevent squish) -->
        <div style="font-size: 0.85em; color: #aaa; flex: 0 0 auto; white-space: nowrap;">
            <i class="fas fa-database"></i> {{sources.summary}}
        </div>

        <!-- Center: Pagination (Flex 1 to take varied space) -->
        <div style="display:flex; align-items:center; justify-content: center; gap: 15px; flex: 1;">
            <button class="page-prev icon-only" title="{{localize "ionrift-library.classifierValidator.previousPageTooltip"}}" {{#unless pagination.hasPrev}}disabled{{/unless}}
                style="width: 32px;">
                <i class="fas fa-chevron-left"></i>
            </button>
            <span style="color:#aaa; font-size: 0.9em; min-width: 100px; text-align: center;">
                {{localize "ionrift-library.classifierValidator.paginationRange" start=pagination.startItem end=pagination.endItem total=pagination.totalItems}}
            </span>
            <button class="page-next icon-only" title="{{localize "ionrift-library.classifierValidator.nextPageTooltip"}}" {{#unless pagination.hasNext}}disabled{{/unless}}
                style="width: 32px;">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>

        <!-- Right: Actions -->
        <div style="flex: 0 0 auto;">
            <button id="export-json" class="export-btn ionrift-save-btn">
                <i class="fas fa-file-export"></i> {{localize "ionrift-library.classifierValidator.exportReportButton"}}
            </button>
        </div>
    </div>
</div>